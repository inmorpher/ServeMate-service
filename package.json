{
	"name": "servemate-service",
	"version": "1.0.0",
	"private": true,
	"workspaces": [
		"dto-package"
	],
	"prisma": {
		"schema": "prisma/schema.prisma"
	},
	"description": "",
	"main": "main.js",
	"scripts": {
		"test-watch": "jest --coverage",
		"test": "jest --coverage",
		"start": "nodemon dist/main.js",
		"build": "rimraf dist && tsc",
		"dev": "nodemon main.ts",
		"mcp": "ts-node src/mcp/server.ts",
		"mcp:prod": "node dist/src/mcp/server.js",
		"start:prod": "pm2 start dist/main.js --name servemate-service",
		"start:cluster": "pm2 start dist/main.js -i 4 --name servemate-service-cluster",
		"pm2:monitor": "pm2 monitor",
		"pm2:startup": "pm2 startup",
		"pm2:save": "pm2 save",
		"pm2:logs": "pm2 logs",
		"pm2:stop": "pm2 stop all",
		"pm2:delete": "pm2 delete all",
		"generate-users": "ts-node src/scripts/addUsers.ts",
		"generate-dto": "ts-node src/scripts/generateDto.ts",
		"generate-orders": "ts-node src/scripts/addOrders.ts",
		"generate-tables": "ts-node src/scripts/addTables.ts",
		"generate-fnb": "ts-node src/scripts/addFoodAndDrinks.ts"
	},
	"author": "inmo",
	"license": "ISC",
	"dependencies": {
		"@faker-js/faker": "^10.4.0",
		"@modelcontextprotocol/server-postgres": "^0.6.2",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/auto-instrumentations-node": "^0.76.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
		"@opentelemetry/sdk-node": "^0.218.0",
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"@prisma/generator-helper": "^7.8.0",
		"@servemate/dto": "^1.4.2",
		"axios": "^1.16.1",
		"bcrypt": "^6.0.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"inversify": "^8.1.0",
		"jsonwebtoken": "^9.0.3",
		"node-cache": "^5.1.2",
		"nodemon": "^3.1.14",
		"prisma": "^7.8.0",
		"reflect-metadata": "^0.2.2",
		"tslog": "^4.10.2",
		"uuid": "^14.0.0",
		"ws": "^8.20.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/bcrypt": "^6.0.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/k6": "^2.0.0",
		"@types/node": "^25.8.0",
		"@types/ws": "^8.18.1",
		"@typescript-eslint/eslint-plugin": "^8.59.3",
		"@typescript-eslint/parser": "^8.59.3",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"jest": "^30.4.2",
		"prettier": "^3.8.3",
		"rimraf": "^6.1.3",
		"ts-jest": "^29.4.9",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.3"
	}
}

{
  "name": "servemate-service",
  "version": "1.0.0",
  "private": true,
  "prisma": {
    "schema": "prisma/schema.prisma",
    "config": "prisma/prisma.config.js"
  },
  "description": "",
  "main": "main.js",
  "scripts": {
    "test-watch": "jest --coverage",
    "test": "jest --coverage",
    "start": "nodemon dist/main.js",
    "build": "rimraf dist && tsc",
    "dev": "tsx watch main.ts",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:prod": "node dist/src/mcp/server.js",
    "start:prod": "pm2 start dist/main.js --name servemate-service",
    "start:cluster": "pm2 start dist/main.js -i 4 --name servemate-service-cluster",
    "pm2:monitor": "pm2 monitor",
    "pm2:startup": "pm2 startup",
    "pm2:save": "pm2 save",
    "pm2:logs": "pm2 logs",
    "pm2:stop": "pm2 stop all",
    "pm2:delete": "pm2 delete all",
    "generate-users": "tsx src/scripts/addUsers.ts",
    "generate-orders": "tsx src/scripts/addOrders.ts",
    "generate-tables": "tsx src/scripts/addTables.ts",
    "generate-fnb": "tsx src/scripts/addFoodAndDrinks.ts",
    "openapi:generate": "tsx src/openapi/generate-client-types.ts"
  },
  "author": "inmo",
  "license": "ISC",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
